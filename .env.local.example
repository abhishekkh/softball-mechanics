# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# App
NEXT_PUBLIC_APP_URL=https://your-deployed-domain.vercel.app

# Gemini Flash VLM prototype (Phase 2.2 evaluation — prototype only)
# Get a free API key at: https://aistudio.google.com/app/apikey
# Note: Do NOT add NEXT_PUBLIC_ prefix — this key must stay server-side only
GEMINI_API_KEY=your_gemini_api_key_here

# Resend (transactional email — athlete invites + coach feedback delivery)
# Get a free API key at: https://resend.com/api-keys (free tier: 3,000 emails/month)
# Note: Do NOT add NEXT_PUBLIC_ prefix — this key must stay server-side only
RESEND_API_KEY=re_your_api_key_here
# Optional: set a verified sending domain address (defaults to noreply@resend.dev for dev)
RESEND_FROM_EMAIL=noreply@yourdomain.com
